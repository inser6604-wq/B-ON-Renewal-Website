{{ 'bnon-shopify-detail.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bnon-shopify-detail.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign desktop_image = section.settings.hero_image
  assign mobile_image = section.settings.hero_mobile_image
-%}

<bnon-shopify-detail
  class="bnon-section bnon-shopify-detail"
  data-scroll-enabled="{{ section.settings.enable_scroll }}"
  data-mobile-scroll-enabled="{{ section.settings.enable_mobile_scroll }}"
  data-mobile-autoplay-enabled="{{ section.settings.enable_mobile_autoplay }}"
  data-mobile-autoplay-duration="{{ section.settings.mobile_autoplay_duration | default: 18 | times: 1000 }}"
  data-scroll-range="{{ section.settings.scroll_range | default: 140 }}"
  data-breadcrumb-home-label="{{ section.settings.breadcrumb_home_label | escape }}"
  data-breadcrumb-current-label="{{ section.settings.breadcrumb_current_label | default: page.title | escape }}"
  data-breadcrumb-home-link="{{ section.settings.breadcrumb_home_link | default: routes.root_url | escape }}"
  data-breadcrumb-separator="{{ section.settings.breadcrumb_separator | escape }}"
  data-breadcrumb-label="{{ section.settings.breadcrumb_accessibility_label | escape }}"
>
  <section class="bnon-shopify-detail__inner" aria-labelledby="ShopifyDetailHeading-{{ section.id }}" data-header-theme="light">
    {%- capture detail_heading_id -%}ShopifyDetailHeading-{{ section.id }}{%- endcapture -%}
    {% render 'bnon-service-detail-intro', section: section, active_service: '01', heading_id: detail_heading_id %}

    <div class="bnon-shopify-detail__scroll-stage">
      <div class="bnon-shopify-detail__media">
        <div class="bnon-shopify-detail__screen bnon-shopify-detail__screen--mobile">
          {%- if mobile_image != blank -%}
            {{ mobile_image | image_url: width: 960 | image_tag: class: 'bnon-shopify-detail__image', widths: '240, 480, 720, 960', sizes: '(min-width: 1440px) 356px, (min-width: 768px) 25vw, 28vw', alt: section.settings.mobile_image_alt, loading: 'eager' }}
          {%- elsif section.settings.use_design_images -%}
            <img class="bnon-shopify-detail__image" src="{{ 'bnon-shopify-detail-mobile.png' | asset_url }}" width="479" height="4096" alt="{{ section.settings.mobile_image_alt | escape }}" loading="eager">
          {%- endif -%}
        </div>
        <div class="bnon-shopify-detail__screen bnon-shopify-detail__screen--desktop">
          {%- if desktop_image != blank -%}
            {{ desktop_image | image_url: width: 1600 | image_tag: class: 'bnon-shopify-detail__image', widths: '480, 780, 1208, 1600', sizes: '(min-width: 1440px) 780px, (min-width: 768px) 55vw, 60vw', alt: section.settings.desktop_image_alt, loading: 'eager', fetchpriority: 'high' }}
          {%- elsif section.settings.use_design_images -%}
            <img class="bnon-shopify-detail__image" src="{{ 'bnon-shopify-detail-desktop.png' | asset_url }}" width="1208" height="4096" alt="{{ section.settings.desktop_image_alt | escape }}" loading="eager" fetchpriority="high">
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</bnon-shopify-detail>

{% schema %}
{
  "name": "B&ON Shopify Detail",
  "tag": "div",
  "class": "bnon-shopify-detail-section",
  "limit": 1,
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "영문 제목", "default": "SHOPIFY STORE DEVELOPMENT" },
    { "type": "text", "id": "subtitle", "label": "국문 제목", "default": "쇼피파이 자사몰 구축" },
    { "type": "textarea", "id": "description", "label": "소개 문구", "default": "브랜드의 가능성을 글로벌 스토어로 구현합니다." },
    { "type": "text", "id": "contact_label", "label": "문의 버튼 문구", "default": "프로젝트 문의하기" },
    { "type": "url", "id": "contact_link", "label": "문의 링크", "info": "비워두면 기존 Contact 페이지로 연결됩니다." },
    { "type": "header", "content": "Hero 목업 이미지" },
    { "type": "image_picker", "id": "hero_image", "label": "데스크탑 목업 내부 이미지" },
    { "type": "image_picker", "id": "hero_mobile_image", "label": "모바일 목업 내부 이미지" },
    { "type": "checkbox", "id": "use_design_images", "label": "미선택 시 Figma 원본 이미지 사용", "default": true },
    { "type": "text", "id": "desktop_image_alt", "label": "데스크탑 이미지 설명", "default": "ISIA 쇼피파이 스토어 데스크탑 화면" },
    { "type": "text", "id": "mobile_image_alt", "label": "모바일 이미지 설명", "default": "ISIA 쇼피파이 스토어 모바일 화면" },
    { "type": "header", "content": "페이지 스크롤 연출" },
    { "type": "checkbox", "id": "enable_scroll", "label": "스크롤 애니메이션 활성화", "default": true },
    { "type": "range", "id": "scroll_range", "label": "스크롤 연출 구간", "min": 60, "max": 300, "step": 10, "default": 140, "unit": "vh", "info": "Desktop/Tablet 전용입니다. 값이 클수록 천천히 전체 이미지를 보여줍니다. 모바일은 별도의 재생 시간을 사용합니다." },
    { "type": "checkbox", "id": "enable_mobile_scroll", "label": "모바일 애니메이션 활성화", "default": true, "info": "모바일에서는 페이지 스크롤 대신 아래의 1회 자동 스크롤을 사용합니다." },
    { "type": "checkbox", "id": "enable_mobile_autoplay", "label": "모바일 목업 1회 자동 스크롤", "default": true, "info": "모바일 애니메이션이 활성화된 경우에만 적용됩니다. 화면 밖에서는 멈추고 재진입하면 이어서 진행합니다." },
    { "type": "range", "id": "mobile_autoplay_duration", "label": "모바일 목업 재생 시간", "min": 5, "max": 60, "step": 1, "default": 18, "unit": "초" },
    { "type": "header", "content": "서비스 메뉴 및 경로 표시" },
    { "type": "text", "id": "navigation_label", "label": "서비스 메뉴 접근성 설명", "default": "서비스 상세페이지" },
    { "type": "text", "id": "breadcrumb_home_label", "label": "경로 표시 홈 문구", "default": "HOME" },
    { "type": "url", "id": "breadcrumb_home_link", "label": "경로 표시 홈 링크", "info": "비워두면 기존 홈 주소를 유지합니다." },
    { "type": "text", "id": "breadcrumb_current_label", "label": "경로 표시 현재 페이지명", "info": "비워두면 기존 Shopify 페이지 제목을 유지합니다." },
    { "type": "text", "id": "breadcrumb_separator", "label": "경로 표시 구분 문자", "default": "/" },
    { "type": "text", "id": "breadcrumb_accessibility_label", "label": "경로 표시 접근성 설명", "default": "Breadcrumb" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "서비스 이동",
      "limit": 5,
      "settings": [
        { "type": "select", "id": "number", "label": "서비스 번호", "default": "01", "options": [{ "value": "01", "label": "01 구축" }, { "value": "02", "label": "02 마케팅" }, { "value": "03", "label": "03 법인·물류" }, { "value": "04", "label": "04 아마존" }, { "value": "05", "label": "05 교육" }] },
        { "type": "text", "id": "label", "label": "서비스명" },
        { "type": "page", "id": "page", "label": "연결할 실제 Shopify 페이지", "info": "미생성 페이지는 링크를 표시하지 않습니다." },
        { "type": "text", "id": "display_number", "label": "화면에 표시할 번호", "info": "비워두면 기존 서비스 번호를 표시합니다. 서비스 번호는 라우팅용으로 유지됩니다." },
        { "type": "url", "id": "link", "label": "직접 지정할 서비스 링크", "info": "선택한 Shopify 페이지보다 우선합니다. 비워두면 기존 연결을 유지합니다." }
      ]
    }
  ],
  "presets": [{ "name": "B&ON Shopify Detail", "blocks": [
    { "type": "service", "settings": { "number": "01", "label": "쇼피파이 자사몰 구축" } },
    { "type": "service", "settings": { "number": "02", "label": "디지털 마케팅" } },
    { "type": "service", "settings": { "number": "03", "label": "미국 법인 설립 & 3PL" } },
    { "type": "service", "settings": { "number": "04", "label": "아마존 입점" } },
    { "type": "service", "settings": { "number": "05", "label": "쇼피파이 관리자 교육" } }
  ] }]
}
{% endschema %}
