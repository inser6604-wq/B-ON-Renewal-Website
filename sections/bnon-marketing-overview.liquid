{{ 'bnon-shopify-build.css' | asset_url | stylesheet_tag }}
{{ 'bnon-marketing-sections.css' | asset_url | stylesheet_tag }}

<section class="bnon-section bnon-shopify-build bnon-marketing-overview"{% if section.settings.heading != blank %} aria-labelledby="MarketingOverviewHeading-{{ section.id }}"{% endif %} data-header-theme="light">
  <div class="bnon-shopify-build__inner">
    {%- if section.settings.label != blank -%}
      <div class="bnon-shopify-build__label-row"><p class="bnon-shopify-build__label">{{ section.settings.label | escape }}</p></div>
    {%- endif -%}
    <div class="bnon-shopify-build__intro">
      <div class="bnon-shopify-build__title">
        {%- if section.settings.eyebrow != blank -%}<p class="bnon-shopify-build__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="bnon-shopify-build__heading" id="MarketingOverviewHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}<span class="bnon-shopify-build__accent">{{ section.settings.heading_accent | escape }}</span></h2>{%- endif -%}
      </div>
      {%- if section.settings.description != blank -%}
        <div class="bnon-shopify-build__copy"><div class="bnon-shopify-build__paragraph">{{ section.settings.description }}</div></div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="bnon-shopify-build__pillars" role="list">
        {%- for block in section.blocks -%}
          <li class="bnon-shopify-build__pillar" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}<p class="bnon-shopify-build__number">{{ block.settings.number | escape }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h3 class="bnon-shopify-build__pillar-heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
            {%- if block.settings.description != blank -%}<p class="bnon-shopify-build__pillar-description">{{ block.settings.description | escape | newline_to_br }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "B&ON Connected Marketing",
  "tag": "div",
  "class": "bnon-marketing-overview-section",
  "limit": 1,
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "label", "label": "영문 섹션 라벨", "default": "WHAT WE DO" },
    { "type": "text", "id": "eyebrow", "label": "제목 위 소개", "default": "데이터를 연결하는" },
    { "type": "textarea", "id": "heading", "label": "영문 제목", "default": "CONNECTED\nMARKETING", "info": "줄바꿈을 그대로 표시합니다." },
    { "type": "text", "id": "heading_accent", "label": "제목 끝 강조 문자", "default": "." },
    { "type": "richtext", "id": "description", "label": "설명 및 강조 문구", "default": "<p>광고 플랫폼과 고객 데이터를 연결해 <strong>구매 전환까지 이어지는 마케팅 구조를 설계</strong>합니다.</p>" }
  ],
  "blocks": [
    {
      "type": "channel", "name": "마케팅 항목",
      "settings": [
        { "type": "text", "id": "number", "label": "표시 번호" },
        { "type": "text", "id": "heading", "label": "영문 항목명" },
        { "type": "textarea", "id": "description", "label": "항목 설명" }
      ]
    }
  ],
  "presets": [{ "name": "B&ON Connected Marketing", "blocks": [
    { "type": "channel", "settings": { "number": "01", "heading": "GOOGLE ADS", "description": "광고·분석·구매 데이터 연동" } },
    { "type": "channel", "settings": { "number": "02", "heading": "SEO", "description": "검색 노출을 위한 구조 최적화" } },
    { "type": "channel", "settings": { "number": "03", "heading": "META ADS", "description": "픽셀 기반 전환 추적과 광고 최적화" } }
  ] }]
}
{% endschema %}
