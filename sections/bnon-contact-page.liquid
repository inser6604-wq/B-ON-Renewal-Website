{{ 'bnon-contact-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bnon-contact-page.js' | asset_url }}" defer="defer"></script>

{%- assign form_id = 'BnonContactForm-' | append: section.id -%}

<bnon-contact-page class="bnon-section bnon-contact-page">
  <div class="bnon-contact-page__inner">
    <aside class="bnon-contact-page__intro" aria-labelledby="BnonContactHeading-{{ section.id }}">
      <div class="bnon-contact-page__intro-copy">
        <h1 id="BnonContactHeading-{{ section.id }}" class="bnon-contact-page__heading">{{ section.settings.heading | escape }}</h1>
        <h2 class="bnon-contact-page__title">{{ section.settings.title | escape | newline_to_br }}</h2>
        <div class="bnon-contact-page__description">{{ section.settings.description }}</div>
      </div>

      <div class="bnon-contact-page__details">
        <div>
          <p class="bnon-contact-page__detail-label">EMAIL</p>
          <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
        </div>
        <div>
          <p class="bnon-contact-page__detail-label">PHONE</p>
          <p>{{ section.settings.phone | escape }}</p>
        </div>
        <p>{{ section.settings.availability | escape }}</p>
      </div>

      {%- if section.settings.inquiry_link != blank -%}
        <a class="bnon-contact-page__inquiry-link" href="{{ section.settings.inquiry_link }}">{{ section.settings.inquiry_label | escape }}</a>
      {%- endif -%}
    </aside>

    <div class="bnon-contact-page__form-column" id="contact-form">
      {%- form 'contact', id: form_id, class: 'bnon-contact-form', novalidate: 'novalidate' -%}
        {%- if form.posted_successfully? -%}
          <div class="bnon-contact-form__status bnon-contact-form__status--success" role="status" tabindex="-1" autofocus>
            문의가 정상적으로 접수되었습니다. 빠른 시일 내에 답변드리겠습니다.
          </div>
        {%- elsif form.errors -%}
          <div class="bnon-contact-form__status bnon-contact-form__status--error" role="alert" tabindex="-1" autofocus>
            <strong>문의 전송에 실패했습니다.</strong> 입력 내용을 확인한 뒤 다시 시도해 주세요.
            <ul role="list">
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <fieldset class="bnon-contact-form__basic">
          <legend>기본 정보</legend>
          <div class="bnon-contact-form__fields">
            <div class="bnon-contact-field">
              <label for="{{ form_id }}-company">브랜드, 기업명</label>
              <input id="{{ form_id }}-company" name="contact[브랜드, 기업명]" type="text" autocomplete="organization" value="{{ form['브랜드, 기업명'] | escape }}">
            </div>
            <div class="bnon-contact-field">
              <label for="{{ form_id }}-phone">핸드폰 번호</label>
              <input id="{{ form_id }}-phone" name="contact[phone]" type="tel" autocomplete="tel" value="{{ form.phone | escape }}">
            </div>
            <div class="bnon-contact-field">
              <label for="{{ form_id }}-name">담당자명 <span aria-hidden="true">*</span></label>
              <input id="{{ form_id }}-name" name="contact[담당자명]" type="text" autocomplete="name" value="{{ form['담당자명'] | default: form.name | escape }}" placeholder="성함을 입력해 주세요." required aria-required="true" data-required-field>
              <span class="bnon-contact-field__error" data-error-for="{{ form_id }}-name" aria-live="polite"></span>
            </div>
            <div class="bnon-contact-field">
              <label for="{{ form_id }}-email">EMAIL <span aria-hidden="true">*</span></label>
              <input id="{{ form_id }}-email" name="contact[email]" type="email" autocomplete="email" spellcheck="false" autocapitalize="off" value="{{ form.email | escape }}" placeholder="예) contact@bnonu.com" required aria-required="true" data-required-field>
              <span class="bnon-contact-field__error" data-error-for="{{ form_id }}-email" aria-live="polite"></span>
            </div>
            <div class="bnon-contact-field">
              <label for="{{ form_id }}-position">직급</label>
              <input id="{{ form_id }}-position" name="contact[직급]" type="text" autocomplete="organization-title" value="{{ form['직급'] | escape }}">
            </div>
            <div class="bnon-contact-field bnon-contact-field--select">
              <label for="{{ form_id }}-duration">작업 희망 기간</label>
              <select id="{{ form_id }}-duration" name="contact[작업 희망 기간]">
                <option value="" selected>선택해주세요.</option>
                <option value="2주 이내">2주 이내</option>
                <option value="3–4주">3–4주</option>
                <option value="5–8주">5–8주</option>
                <option value="유연함 (상담 원함)">유연함 (상담 원함)</option>
              </select>
            </div>
          </div>
        </fieldset>

        <fieldset class="bnon-contact-form__services">
          <legend>필요한 서비스</legend>
          <p id="{{ form_id }}-services-help">문의하실 서비스를 선택해주세요. (복수 선택 가능)</p>
          <div class="bnon-contact-form__service-list" aria-describedby="{{ form_id }}-services-help">
            {%- assign services = '스토어 구축|쇼피파이 관리자 교육|제품 이미지 및 상세페이지 제작|마케팅 (메타, 구글, SEO)|아마존 입점|미국 법인 설립 & 은행계좌 개설|글로벌 3PL 물류|미국 틱톡샵 계정 생성' | split: '|' -%}
            {%- for service in services -%}
              <div class="bnon-contact-form__service">
                <input id="{{ form_id }}-service-{{ forloop.index }}" type="checkbox" value="{{ service | escape }}" data-service-option>
                <label for="{{ form_id }}-service-{{ forloop.index }}">{{ service | escape }}</label>
              </div>
            {%- endfor -%}
          </div>
          <input type="hidden" name="contact[필요한 서비스]" value="" data-services-value>
        </fieldset>

        <div class="bnon-contact-field bnon-contact-field--message">
          <label for="{{ form_id }}-body">문의사항 <span aria-hidden="true">*</span></label>
          <textarea id="{{ form_id }}-body" name="contact[body]" rows="3" placeholder="브랜드 소개, 필요한 서비스, 희망 일정 등 프로젝트와 관련된 내용을 자유롭게 작성해 주세요." required aria-required="true" data-required-field>{{ form.body }}</textarea>
          <span class="bnon-contact-field__error" data-error-for="{{ form_id }}-body" aria-live="polite"></span>
        </div>

        <div class="bnon-contact-form__privacy">
          <input id="{{ form_id }}-privacy" name="contact[개인정보 수집 및 이용 동의]" type="checkbox" value="동의" required aria-required="true" data-privacy>
          <label for="{{ form_id }}-privacy"><span aria-hidden="true">*</span> 개인정보 수집 및 이용에 동의합니다</label>
          <span class="bnon-contact-field__error" data-error-for="{{ form_id }}-privacy" aria-live="polite"></span>
        </div>

        <button class="bnon-contact-form__submit" type="submit" disabled data-contact-submit>프로젝트 문의하기</button>
      {%- endform -%}
    </div>
  </div>
</bnon-contact-page>

{% schema %}
{
  "name": "B&ON Contact page",
  "tag": "section",
  "class": "bnon-contact-page-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "CONTACT" },
    { "type": "textarea", "id": "title", "label": "Intro title", "default": "브랜드의 다음 단계를\n함께 설계합니다" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>B&ON Universe는 브랜드의 가능성을 글로벌 시장으로 확장하는 파트너입니다. 프로젝트에 대한 정보와 문의를 남겨주시면, 빠른 시일 내에 답변드리겠습니다.</p>" },
    { "type": "text", "id": "email", "label": "Email", "default": "contact@bnonu.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+82 10 2352 0212 / +82 10 6396 5756" },
    { "type": "text", "id": "availability", "label": "Availability", "default": "연중무휴 / 24시간 상담 / 온라인미팅 / 대면미팅" },
    { "type": "text", "id": "inquiry_label", "label": "Inquiry button label", "default": "온라인문의" },
    { "type": "url", "id": "inquiry_link", "label": "Inquiry button link" }
  ],
  "presets": [{ "name": "B&ON Contact page" }]
}
{% endschema %}
