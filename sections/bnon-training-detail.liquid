{{ 'bnon-shopify-detail.css' | asset_url | stylesheet_tag }}
{{ 'bnon-training-detail.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bnon-shopify-detail.js' | asset_url }}" defer="defer"></script>

<bnon-shopify-detail class="bnon-section bnon-shopify-detail bnon-training-detail" data-intro-only
  data-breadcrumb-home-label="{{ section.settings.breadcrumb_home_label | escape }}"
  data-breadcrumb-current-label="{{ section.settings.breadcrumb_current_label | default: page.title | escape }}"
  data-breadcrumb-home-link="{{ section.settings.breadcrumb_home_link | default: routes.root_url | escape }}"
  data-breadcrumb-separator="{{ section.settings.breadcrumb_separator | escape }}"
  data-breadcrumb-label="{{ section.settings.breadcrumb_accessibility_label | escape }}">
  {%- capture detail_heading_id -%}TrainingDetailHeading-{{ section.id }}{%- endcapture -%}
  <section class="bnon-shopify-detail__inner" aria-labelledby="{{ detail_heading_id }}" data-header-theme="light">
    {% render 'bnon-service-detail-intro', section: section, active_service: '05', heading_id: detail_heading_id %}
    <div class="bnon-shopify-benefits__intro bnon-training-detail__art">
      <p class="bnon-training-detail__word bnon-training-detail__word--learn">{{ section.settings.learn_word | escape }}</p>
      <p class="bnon-training-detail__word bnon-training-detail__word--manage">{{ section.settings.manage_word | escape }}</p>
      <p class="bnon-training-detail__word bnon-training-detail__word--grow">{{ section.settings.grow_word | escape }}</p>
      <div class="bnon-training-detail__cursor">
        {%- if section.settings.cursor_image != blank -%}
          {{ section.settings.cursor_image | image_url: width: 700 | image_tag: widths: '260, 520, 700', sizes: '(min-width: 1200px) 253px, 24vw', alt: section.settings.cursor_alt, loading: 'eager' }}
        {%- else -%}<img src="{{ 'bnon-training-cursor.png' | asset_url }}" width="1313" height="1198" alt="{{ section.settings.cursor_alt | escape }}" loading="eager">{%- endif -%}
      </div>
      <div class="bnon-training-detail__badge">
        {%- if section.settings.badge_image != blank -%}
          {{ section.settings.badge_image | image_url: width: 90 | image_tag: alt: section.settings.badge_alt, loading: 'eager' }}
        {%- else -%}<img src="{{ 'bnon-training-shopify.svg' | asset_url }}" width="44.1101" height="49.9559" alt="{{ section.settings.badge_alt | escape }}" loading="eager">{%- endif -%}
        <div><p>{{ section.settings.badge_label | escape }}</p><p>{{ section.settings.badge_title | escape }}</p></div>
      </div>
    </div>
  </section>
</bnon-shopify-detail>

{% schema %}
{
  "name": "B&ON Admin Training Hero", "tag": "div", "class": "bnon-training-detail-section", "limit": 1,
  "enabled_on": { "templates": ["page"] }, "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "영문 서비스 라벨", "default": "SHOPIFY ADMIN TRAINING" },
    { "type": "textarea", "id": "subtitle", "label": "국문 메인 제목", "default": "구축 이후의 운영까지\n직접 할 수 있도록" },
    { "type": "textarea", "id": "description", "label": "서비스 설명", "default": "상품 등록부터 주문·재고 관리, 마케팅과 고객 응대까지.\n실제 구축된 스토어를 기반으로 Shopify 관리자 기능을\n익히는 실무 교육을 제공합니다." },
    { "type": "text", "id": "contact_label", "label": "문의 버튼 문구", "default": "프로젝트 문의하기" },
    { "type": "url", "id": "contact_link", "label": "문의 버튼 링크", "info": "비워두면 기존 상세페이지와 동일한 Contact 페이지로 연결합니다." },
    { "type": "text", "id": "learn_word", "label": "Hero 첫 번째 강조 단어", "default": "LEARN" },
    { "type": "text", "id": "manage_word", "label": "Hero 두 번째 강조 단어", "default": "MANAGE" },
    { "type": "text", "id": "grow_word", "label": "Hero 세 번째 강조 단어", "default": "GROW" },
    { "type": "image_picker", "id": "cursor_image", "label": "Hero 커서 이미지", "info": "비워두면 Figma 원본 커서를 사용합니다." },
    { "type": "text", "id": "cursor_alt", "label": "커서 대체 텍스트", "default": "투명한 블루 커서" },
    { "type": "image_picker", "id": "badge_image", "label": "배지 로고 이미지" },
    { "type": "text", "id": "badge_alt", "label": "배지 로고 대체 텍스트", "default": "Shopify" },
    { "type": "text", "id": "badge_label", "label": "배지 상단 문구", "default": "SHOPIFY" },
    { "type": "text", "id": "badge_title", "label": "배지 하단 문구", "default": "ADMIN TRAINING" },
    { "type": "text", "id": "navigation_label", "label": "서비스 메뉴 접근성 설명", "default": "서비스 상세페이지" },
    { "type": "text", "id": "breadcrumb_home_label", "label": "경로 표시 홈 문구", "default": "HOME" },
    { "type": "url", "id": "breadcrumb_home_link", "label": "경로 표시 홈 링크" },
    { "type": "text", "id": "breadcrumb_current_label", "label": "경로 표시 현재 페이지명", "default": "SHOPIFY ADMIN TRAINING" },
    { "type": "text", "id": "breadcrumb_separator", "label": "경로 표시 구분 문자", "default": "/" },
    { "type": "text", "id": "breadcrumb_accessibility_label", "label": "경로 표시 접근성 설명", "default": "Breadcrumb" }
  ],
  "blocks": [{ "type": "service", "name": "서비스 이동", "limit": 5, "settings": [
    { "type": "select", "id": "number", "label": "서비스 번호", "default": "01", "options": [{ "value": "01", "label": "01 구축" }, { "value": "02", "label": "02 마케팅" }, { "value": "03", "label": "03 법인·물류 연계" }, { "value": "04", "label": "04 아마존" }, { "value": "05", "label": "05 교육" }] },
    { "type": "text", "id": "display_number", "label": "화면에 표시할 번호" },
    { "type": "text", "id": "label", "label": "서비스명" },
    { "type": "page", "id": "page", "label": "연결할 실제 Shopify 페이지" },
    { "type": "url", "id": "link", "label": "직접 지정할 서비스 링크" }
  ] }],
  "presets": [{ "name": "B&ON Admin Training Hero", "blocks": [
    { "type": "service", "settings": { "number": "01", "label": "쇼피파이 자사몰 구축" } },
    { "type": "service", "settings": { "number": "02", "label": "디지털 마케팅" } },
    { "type": "service", "settings": { "number": "03", "label": "미국 법인 설립 & 물류 연계" } },
    { "type": "service", "settings": { "number": "04", "label": "아마존 입점" } },
    { "type": "service", "settings": { "number": "05", "label": "쇼피파이 관리자 교육" } }
  ] }]
}
{% endschema %}
