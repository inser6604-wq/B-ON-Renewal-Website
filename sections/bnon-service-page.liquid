{{ 'bnon-service-page.css' | asset_url | stylesheet_tag }}

<section class="bnon-section bnon-service-page" aria-labelledby="BnonServiceHeading-{{ section.id }}">
  <div class="bnon-service-page__inner">
    <h1 class="bnon-service-page__heading" id="BnonServiceHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>

    <div class="bnon-service-page__list">
      {%- for block in section.blocks -%}
        <article class="bnon-service-card" {{ block.shopify_attributes }}>
          <p class="bnon-service-card__count" aria-label="{{ block.settings.number | escape }} / {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}">
            <span>{{ block.settings.number | escape }}</span><span aria-hidden="true"> / {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
          </p>

          <h2 class="bnon-service-card__title">{{ block.settings.title | escape }}</h2>

          <div class="bnon-service-card__copy">
            {%- if block.settings.category != blank -%}
              <p class="bnon-service-card__category">{{ block.settings.category | escape }}</p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <div class="bnon-service-card__description">{{ block.settings.description }}</div>
            {%- endif -%}
          </div>

          <div class="bnon-service-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'bnon-service-card__image', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 1024px) 477px, (min-width: 768px) 42vw, calc(100vw - 72px)', alt: block.settings.image.alt, loading: 'lazy' }}
            {%- elsif forloop.first -%}
              <img class="bnon-service-card__image" src="{{ 'bnon-service-development.png' | asset_url }}" alt="" width="529" height="794" loading="eager">
            {%- else -%}
              <div class="bnon-service-card__placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            <a class="bnon-service-card__link" href="{{ block.settings.link }}">
              <span>{{ block.settings.link_label | escape }}</span><span aria-hidden="true">→</span>
            </a>
          {%- else -%}
            <span class="bnon-service-card__link bnon-service-card__link--disabled" aria-disabled="true">
              <span>{{ block.settings.link_label | escape }}</span><span aria-hidden="true">→</span>
            </span>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "B&ON Service page",
  "tag": "section",
  "class": "bnon-service-page-section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "페이지 제목",
      "default": "SERVICE"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "number", "label": "번호", "default": "01" },
        { "type": "text", "id": "title", "label": "서비스 제목", "default": "SHOPIFY STORE DEVELOPMENT" },
        { "type": "text", "id": "category", "label": "카테고리" },
        { "type": "richtext", "id": "description", "label": "설명" },
        { "type": "image_picker", "id": "image", "label": "서비스 이미지" },
        { "type": "url", "id": "link", "label": "링크" },
        { "type": "text", "id": "link_label", "label": "링크 문구", "default": "VIEW SERVICE" }
      ]
    }
  ],
  "presets": [
    {
      "name": "B&ON Service page",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "number": "01",
            "title": "SHOPIFY STORE DEVELOPMENT",
            "category": "STRATEGY · UX/UI · DEVELOPMENT",
            "description": "<p>브랜드의 정체성과 비즈니스 목표를 바탕으로 <strong>사용자 경험을 설계</strong>하고, <strong>Shopify 기반의 안정적이고 확장 가능한 스토어</strong>를 구축합니다. 디자인과 개발은 물론 <strong>결제·배송·다국어·다통화 환경</strong>까지 세밀하게 연결하여, 브랜드가 글로벌 시장에서도 지속적으로 판매하고 성장할 수 있는 커머스 환경을 완성합니다.</p>"
          }
        },
        { "type": "service", "settings": { "number": "02", "title": "DIGITAL MARKETING" } },
        { "type": "service", "settings": { "number": "03", "title": "US CORPORATION & 3PL" } },
        { "type": "service", "settings": { "number": "04", "title": "AMAZON" } },
        { "type": "service", "settings": { "number": "05", "title": "SHOPIFY EDUCATION" } }
      ]
    }
  ]
}
{% endschema %}
