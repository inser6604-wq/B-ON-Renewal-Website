{{ 'bnon-service-page.css' | asset_url | stylesheet_tag }}

<section class="bnon-section bnon-service-page" data-bnon-service-stack aria-labelledby="BnonServiceHeading-{{ section.id }}">
  <div class="bnon-service-page__inner">
    <h1 class="bnon-service-page__heading" id="BnonServiceHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>

    <div class="bnon-service-page__list">
      {%- for block in section.blocks -%}
        <article id="service-{{ forloop.index | prepend: '0' }}" class="bnon-service-card" data-bnon-service-card data-bnon-service-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <p class="bnon-service-card__count" aria-label="{{ block.settings.number | escape }} / {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}">
            <span>{{ block.settings.number | escape }}</span><span aria-hidden="true"> / {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
          </p>

          <h2 class="bnon-service-card__title">{{ block.settings.title | escape }}</h2>

          <div class="bnon-service-card__copy">
            {%- if block.settings.category != blank -%}
              <p class="bnon-service-card__category">{{ block.settings.category | escape }}</p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <div class="bnon-service-card__description">{{ block.settings.description }}</div>
            {%- endif -%}
          </div>

          <div class="bnon-service-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'bnon-service-card__image', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 1024px) 477px, (min-width: 768px) 42vw, calc(100vw - 72px)', alt: block.settings.image.alt, loading: 'lazy' }}
            {%- elsif forloop.first -%}
              <img class="bnon-service-card__image" src="{{ 'bnon-service-development.png' | asset_url }}" alt="" width="529" height="794" loading="eager">
            {%- else -%}
              <div class="bnon-service-card__placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            <a class="bnon-service-card__link" href="{{ block.settings.link }}">
              <span>{{ block.settings.link_label | escape }}</span><span aria-hidden="true">→</span>
            </a>
          {%- else -%}
            <span class="bnon-service-card__link bnon-service-card__link--disabled" aria-disabled="true">
              <span>{{ block.settings.link_label | escape }}</span><span aria-hidden="true">→</span>
            </span>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% javascript %}
  (() => {
    const selector = '[data-bnon-service-stack]';
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    class BnonServiceStack {
      constructor(section) {
        this.section = section;
        this.cards = Array.from(section.querySelectorAll('.bnon-service-card'));
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.mobile = window.matchMedia('(max-width: 480px)');
        this.current = this.cards.map(() => 0);
        this.target = this.cards.map(() => 0);
        this.enteredCards = new Set();
        this.frame = null;
        this.destroyed = false;
        this.requestUpdate = this.requestUpdate.bind(this);
        this.animate = this.animate.bind(this);
        this.handleMotionChange = this.handleMotionChange.bind(this);
        this.handleModeChange = this.handleModeChange.bind(this);
        this.handleHashChange = this.handleHashChange.bind(this);
        window.addEventListener('scroll', this.requestUpdate, { passive: true });
        window.addEventListener('resize', this.requestUpdate, { passive: true });
        window.addEventListener('hashchange', this.handleHashChange);
        this.reducedMotion.addEventListener('change', this.handleMotionChange);
        this.mobile.addEventListener('change', this.handleModeChange);
        this.handleModeChange();
        requestAnimationFrame(() => this.handleHashChange());
      }

      enableMobileReveal() {
        if (this.frame !== null) window.cancelAnimationFrame(this.frame);
        this.frame = null;
        this.cards.forEach((card) => {
          card.style.removeProperty('--bnon-service-dim');
          card.style.removeProperty('--bnon-service-scale');
          card.style.removeProperty('--bnon-service-lift');
        });
        this.section.classList.add('is-mobile-reveal-ready');
        if (this.reducedMotion.matches) {
          this.cards.forEach((card) => card.classList.add('is-mobile-visible'));
          return;
        }
        this.revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-mobile-visible');
            this.playEntrance(this.cards.indexOf(entry.target));
            this.revealObserver.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        this.cards.forEach((card) => this.revealObserver.observe(card));
      }

      disableMobileReveal() {
        this.revealObserver?.disconnect();
        this.revealObserver = null;
        this.section.classList.remove('is-mobile-reveal-ready');
        this.cards.forEach((card) => card.classList.remove('is-mobile-visible'));
      }

      handleModeChange() {
        this.disableMobileReveal();
        if (this.mobile.matches) this.enableMobileReveal();
        else this.requestUpdate();
      }

      calculateTargets() {
        this.cards.forEach((card, index) => {
          const nextCard = this.cards[index + 1];
          if (!nextCard) {
            this.target[index] = 0;
            return;
          }

          const nextTop = nextCard.getBoundingClientRect().top;
          const nextStickyTop = parseFloat(window.getComputedStyle(nextCard).top) || 0;
          const transitionStart = Math.min(window.innerHeight * 0.82, nextStickyTop + card.offsetHeight * 0.75);
          const transitionDistance = Math.max(transitionStart - nextStickyTop, 1);
          this.target[index] = clamp((transitionStart - nextTop) / transitionDistance, 0, 1);
        });
      }

      activeCardIndex() {
        let active = 0;
        this.target.forEach((progress, index) => {
          if (progress > .12) active = Math.min(index + 1, this.cards.length - 1);
        });
        return active;
      }

      playEntrance(index) {
        if (this.reducedMotion.matches || this.enteredCards.has(index)) return;
        this.enteredCards.add(index);
        const card = this.cards[index];
        if (!card?.animate) return;
        const enter = (selector, distance, delay, imageOnly = false) => {
          const element = card.querySelector(selector);
          if (!element) return;
          this.entranceAnimations.push(element.animate(
            imageOnly
              ? [{ opacity: 0 }, { opacity: 1 }]
              : [{ opacity: 0, transform: `translateY(${distance}px)` }, { opacity: 1, transform: 'none' }],
            { duration: 700, delay, easing: 'cubic-bezier(.22, 1, .36, 1)', fill: 'backwards' }
          ));
        };
        this.entranceAnimations ||= [];
        enter('.bnon-service-card__title', 16, 60);
        enter('.bnon-service-card__category', 12, 160);
        enter('.bnon-service-card__description', 12, 260);
        enter('.bnon-service-card__link', 10, 360);
        enter('.bnon-service-card__media', 0, 260, true);
        enter('.bnon-service-card__count', 0, 440, true);
      }

      handleHashChange() {
        const match = window.location.hash.match(/^#service-(0[1-5])$/);
        if (!match) return;
        const index = Number(match[1]) - 1;
        const card = this.cards[index];
        if (!card) return;
        window.cancelAnimationFrame(this.hashFrame);
        this.hashFrame = window.requestAnimationFrame(() => {
          const stickyTop = parseFloat(window.getComputedStyle(card).top) || 0;
          const list = card.parentElement;
          const listDocumentTop = list.getBoundingClientRect().top + window.scrollY;
          const rowGap = parseFloat(window.getComputedStyle(list).rowGap) || 0;
          const cardsBefore = this.cards.slice(0, index);
          const targetTop = Math.max(
            0,
            listDocumentTop
              + cardsBefore.reduce((position, previousCard) => position + previousCard.offsetHeight + rowGap, 0)
              - stickyTop
          );

          // Sticky cards report their current visual offset, not their original
          // grid row. Build the target from the static list flow instead.
          if (window.bnonLenis) window.bnonLenis.scrollTo(targetTop, { immediate: true, force: true });
          else window.scrollTo({ top: targetTop, behavior: 'auto' });
          this.playEntrance(index);
          this.requestUpdate();
        });
      }

      renderCard(card, progress) {
        card.style.setProperty('--bnon-service-dim', (progress * 0.36).toFixed(4));
        card.style.setProperty('--bnon-service-scale', (1 - progress * 0.025).toFixed(4));
        card.style.setProperty('--bnon-service-lift', `${(progress * -6).toFixed(2)}px`);
      }

      animate() {
        this.frame = null;
        if (this.destroyed || this.mobile.matches) return;
        this.calculateTargets();
        let needsAnotherFrame = false;

        this.cards.forEach((card, index) => {
          if (this.reducedMotion.matches) {
            this.current[index] = this.target[index];
          } else {
            this.current[index] += (this.target[index] - this.current[index]) * 0.16;
          }

          if (Math.abs(this.target[index] - this.current[index]) > 0.001) {
            needsAnotherFrame = true;
          } else {
            this.current[index] = this.target[index];
          }
          this.renderCard(card, this.current[index]);
        });

        this.playEntrance(this.activeCardIndex());

        if (needsAnotherFrame) this.frame = window.requestAnimationFrame(this.animate);
      }

      requestUpdate() {
        if (this.mobile.matches) return;
        if (this.frame === null) this.frame = window.requestAnimationFrame(this.animate);
      }

      handleMotionChange() {
        if (this.mobile.matches) this.handleModeChange();
        else this.requestUpdate();
      }

      destroy() {
        this.destroyed = true;
        window.removeEventListener('scroll', this.requestUpdate);
        window.removeEventListener('resize', this.requestUpdate);
        this.reducedMotion.removeEventListener('change', this.handleMotionChange);
        this.mobile.removeEventListener('change', this.handleModeChange);
        window.removeEventListener('hashchange', this.handleHashChange);
        this.disableMobileReveal();
        this.entranceAnimations?.forEach((animation) => animation.cancel());
        window.cancelAnimationFrame(this.hashFrame);
        if (this.frame !== null) window.cancelAnimationFrame(this.frame);
      }
    }

    const instances = new WeakMap();
    const init = (scope = document) => {
      scope.querySelectorAll(selector).forEach((section) => {
        if (!instances.has(section)) instances.set(section, new BnonServiceStack(section));
      });
    };
    const unload = (event) => {
      const section = event.target.querySelector(selector);
      const instance = section && instances.get(section);
      if (!instance) return;
      instance.destroy();
      instances.delete(section);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => init());
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', (event) => init(event.target));
    document.addEventListener('shopify:section:unload', unload);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "B&ON Service page",
  "tag": "section",
  "class": "bnon-service-page-section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "페이지 제목",
      "default": "SERVICE"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "number", "label": "번호", "default": "01" },
        { "type": "text", "id": "title", "label": "서비스 제목", "default": "SHOPIFY STORE DEVELOPMENT" },
        { "type": "text", "id": "category", "label": "카테고리" },
        { "type": "richtext", "id": "description", "label": "설명" },
        { "type": "image_picker", "id": "image", "label": "서비스 이미지" },
        { "type": "url", "id": "link", "label": "링크" },
        { "type": "text", "id": "link_label", "label": "링크 문구", "default": "VIEW SERVICE" }
      ]
    }
  ],
  "presets": [
    {
      "name": "B&ON Service page",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "number": "01",
            "title": "SHOPIFY STORE DEVELOPMENT",
            "category": "STRATEGY · UX/UI · DEVELOPMENT",
            "description": "<p>브랜드의 정체성과 비즈니스 목표를 바탕으로 <strong>사용자 경험을 설계</strong>하고, <strong>Shopify 기반의 안정적이고 확장 가능한 스토어</strong>를 구축합니다. 디자인과 개발은 물론 <strong>결제·배송·다국어·다통화 환경</strong>까지 세밀하게 연결하여, 브랜드가 글로벌 시장에서도 지속적으로 판매하고 성장할 수 있는 커머스 환경을 완성합니다.</p>"
          }
        },
        { "type": "service", "settings": { "number": "02", "title": "DIGITAL MARKETING" } },
        { "type": "service", "settings": { "number": "03", "title": "US CORPORATION & 3PL" } },
        { "type": "service", "settings": { "number": "04", "title": "AMAZON" } },
        { "type": "service", "settings": { "number": "05", "title": "SHOPIFY EDUCATION" } }
      ]
    }
  ]
}
{% endschema %}
