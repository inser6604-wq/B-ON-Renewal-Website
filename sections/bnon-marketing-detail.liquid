{{ 'bnon-shopify-detail.css' | asset_url | stylesheet_tag }}
{{ 'bnon-marketing-detail.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bnon-shopify-detail.js' | asset_url }}" defer="defer"></script>

<bnon-shopify-detail
  class="bnon-section bnon-shopify-detail bnon-marketing-detail"
  data-bnon-ampersand-scope
  data-intro-only
  data-breadcrumb-home-label="{{ section.settings.breadcrumb_home_label | escape }}"
  data-breadcrumb-current-label="{{ section.settings.breadcrumb_current_label | default: page.title | escape }}"
  data-breadcrumb-home-link="{{ section.settings.breadcrumb_home_link | default: routes.root_url | escape }}"
  data-breadcrumb-separator="{{ section.settings.breadcrumb_separator | escape }}"
  data-breadcrumb-label="{{ section.settings.breadcrumb_accessibility_label | escape }}"
>
  {%- capture detail_heading_id -%}MarketingDetailHeading-{{ section.id }}{%- endcapture -%}
  <section class="bnon-shopify-detail__inner" aria-labelledby="{{ detail_heading_id }}" data-header-theme="light">
    {% render 'bnon-service-detail-intro', section: section, active_service: '02', heading_id: detail_heading_id %}

    {%- assign image_blocks = section.blocks | where: 'type', 'case_image' -%}
    {%- if image_blocks.size > 0 -%}
      <figure class="bnon-marketing-detail__gallery"{% if section.settings.gallery_label != blank %} aria-label="{{ section.settings.gallery_label | escape }}"{% endif %}>
        <div class="bnon-marketing-detail__grid">
          {%- for block in image_blocks -%}
            {%- liquid
              assign design_asset = 'bnon-marketing-hero-cclime-model.png'
              assign design_width = 800
              assign design_height = 1040
              case block.settings.design_image
                when 'products'
                  assign design_asset = 'bnon-marketing-hero-cclime-products.png'
                  assign design_width = 1080
                  assign design_height = 1350
                when 'device'
                  assign design_asset = 'bnon-marketing-hero-cclime-device.png'
                  assign design_height = 1200
              endcase
            -%}
            <div class="bnon-marketing-detail__card bnon-marketing-detail__card--{{ block.settings.design_image | default: 'model' | escape }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'bnon-marketing-detail__image', widths: '320, 480, 720, 960, 1200, 1600', sizes: '(min-width: 1440px) 388px, (min-width: 768px) 30vw, calc(100vw - 40px)', alt: block.settings.image_alt, loading: 'eager' }}
              {%- elsif block.settings.use_design_image -%}
                <img class="bnon-marketing-detail__image bnon-marketing-detail__image--design" src="{{ design_asset | asset_url }}" width="{{ design_width }}" height="{{ design_height }}" alt="{{ block.settings.image_alt | escape }}" loading="eager">
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.brand_label != blank or section.settings.case_description != blank -%}
          <figcaption class="bnon-marketing-detail__caption">
            {%- if section.settings.brand_label != blank -%}<span class="bnon-marketing-detail__brand">{{ section.settings.brand_label | escape }}{% if section.settings.caption_separator != blank %}  {{ section.settings.caption_separator | escape }}{% endif %}</span>{%- endif -%}
            {%- if section.settings.case_description != blank -%}<span class="bnon-marketing-detail__caption-copy">{{ section.settings.case_description | escape }}</span>{%- endif -%}
          </figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}
  </section>
</bnon-shopify-detail>

{% schema %}
{
  "name": "B&ON Marketing Hero",
  "tag": "div",
  "class": "bnon-marketing-detail-section",
  "limit": 1,
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "영문 제목", "default": "DIGITAL MARKETING" },
    { "type": "text", "id": "subtitle", "label": "국문 제목", "default": "디지털 마케팅" },
    { "type": "textarea", "id": "description", "label": "소개 문구", "default": "브랜드의 가능성을 성과로 연결합니다." },
    { "type": "text", "id": "contact_label", "label": "문의 버튼 문구", "default": "프로젝트 문의하기" },
    { "type": "url", "id": "contact_link", "label": "문의 링크", "info": "비워두면 첫 번째 상세페이지와 동일한 Contact 페이지로 연결됩니다." },
    { "type": "header", "content": "마케팅 사례 이미지 및 캡션" },
    { "type": "text", "id": "brand_label", "label": "사례 브랜드명", "default": "CCLIME" },
    { "type": "text", "id": "caption_separator", "label": "브랜드명 뒤 구분 문자", "default": "—" },
    { "type": "textarea", "id": "case_description", "label": "사례 설명", "default": "DIGITAL MARKETING · META ADS" },
    { "type": "text", "id": "gallery_label", "label": "이미지 영역 접근성 설명", "default": "CCLIME 디지털 마케팅 사례" },
    { "type": "header", "content": "서비스 내비게이션 및 경로 표시" },
    { "type": "text", "id": "navigation_label", "label": "서비스 메뉴 접근성 설명", "default": "서비스 상세페이지" },
    { "type": "text", "id": "breadcrumb_home_label", "label": "경로 표시 홈 문구", "default": "HOME" },
    { "type": "url", "id": "breadcrumb_home_link", "label": "경로 표시 홈 링크" },
    { "type": "text", "id": "breadcrumb_current_label", "label": "경로 표시 현재 페이지명", "info": "비워두면 실제 Shopify 페이지 제목을 유지합니다." },
    { "type": "text", "id": "breadcrumb_separator", "label": "경로 표시 구분 문자", "default": "/" },
    { "type": "text", "id": "breadcrumb_accessibility_label", "label": "경로 표시 접근성 설명", "default": "Breadcrumb" }
  ],
  "blocks": [
    {
      "type": "service", "name": "서비스 이동", "limit": 5,
      "settings": [
        { "type": "select", "id": "number", "label": "서비스 번호", "default": "01", "options": [{ "value": "01", "label": "01 구축" }, { "value": "02", "label": "02 마케팅" }, { "value": "03", "label": "03 법인·물류" }, { "value": "04", "label": "04 아마존" }, { "value": "05", "label": "05 교육" }] },
        { "type": "text", "id": "display_number", "label": "화면에 표시할 번호", "info": "비워두면 서비스 번호를 표시합니다." },
        { "type": "text", "id": "label", "label": "서비스명" },
        { "type": "page", "id": "page", "label": "연결할 실제 Shopify 페이지" },
        { "type": "url", "id": "link", "label": "직접 지정할 서비스 링크", "info": "선택한 페이지보다 우선합니다. 미생성 페이지는 임의 주소로 연결하지 않습니다." }
      ]
    },
    {
      "type": "case_image", "name": "사례 이미지", "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "사례 이미지" },
        { "type": "text", "id": "image_alt", "label": "이미지 설명" },
        { "type": "checkbox", "id": "use_design_image", "label": "이미지 미선택 시 Figma 원본 사용", "default": true },
        { "type": "select", "id": "design_image", "label": "기본 Figma 이미지", "default": "model", "options": [{ "value": "model", "label": "모델과 토너" }, { "value": "products", "label": "토너 및 핑크 제품" }, { "value": "device", "label": "뷰티 디바이스" }] }
      ]
    }
  ],
  "presets": [{ "name": "B&ON Marketing Hero", "blocks": [
    { "type": "service", "settings": { "number": "01", "label": "쇼피파이 자사몰 구축" } },
    { "type": "service", "settings": { "number": "02", "label": "디지털 마케팅" } },
    { "type": "service", "settings": { "number": "03", "label": "미국 법인 설립 & 3PL" } },
    { "type": "service", "settings": { "number": "04", "label": "아마존 입점" } },
    { "type": "service", "settings": { "number": "05", "label": "쇼피파이 관리자 교육" } },
    { "type": "case_image", "settings": { "design_image": "model", "image_alt": "CCLIME 토너를 소개하는 모델" } },
    { "type": "case_image", "settings": { "design_image": "products", "image_alt": "CCLIME 토너와 핑크 스킨케어 제품" } },
    { "type": "case_image", "settings": { "design_image": "device", "image_alt": "CCLIME 뷰티 디바이스와 스킨케어 제품" } }
  ] }]
}
{% endschema %}
