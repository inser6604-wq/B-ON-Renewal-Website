<bnon-portfolio-gallery-entrance>
<section id="bnon-portfolio-gallery-{{ section.id }}" class="bnon-section bnon-portfolio-gallery" aria-labelledby="bnon-portfolio-gallery-heading-{{ section.id }}">
  <div class="bnon-container bnon-portfolio-gallery__intro">
    <h1 class="bnon-portfolio-gallery__heading" id="bnon-portfolio-gallery-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.description != blank -%}<p class="bnon-portfolio-gallery__description">{{ section.settings.description | escape | newline_to_br }}</p>{%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<p class="bnon-portfolio-gallery__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  </div>

  <bnon-portfolio-mobile-slider class="bnon-portfolio-gallery__reveal">
  <div class="bnon-portfolio-gallery__stage is-initializing" aria-label="{{ section.settings.heading | escape }} 프로젝트 갤러리">
    {%- for block in section.blocks limit: 7 -%}
      {%- liquid
        assign desktop_mockup = block.settings.mockup_desktop_image | default: block.settings.mockup_image
        assign phone_mockup = block.settings.mockup_phone_image | default: block.settings.mockup_image
      -%}
      <article class="bnon-portfolio-gallery__card bnon-portfolio-gallery__item" tabindex="0" data-bnon-portfolio-card data-bnon-portfolio-card-index="{{ forloop.index }}" aria-label="{{ block.settings.project_name | escape }}{% if block.settings.category != blank %}, {{ block.settings.category | escape }}{% endif %}" {% if desktop_mockup != blank or phone_mockup != blank %}role="button" aria-haspopup="dialog" aria-controls="bnon-portfolio-mockup-modal" data-mockup-trigger data-mockup-title="{{ block.settings.project_name | escape }}" data-live-site-url="{{ block.settings.live_site_url | escape }}" {% if desktop_mockup != blank %}data-mockup-desktop-src="{{ desktop_mockup | image_url: width: 2400 }}" data-mockup-desktop-width="{{ desktop_mockup.width }}" data-mockup-desktop-height="{{ desktop_mockup.height }}"{% endif %} {% if phone_mockup != blank %}data-mockup-phone-src="{{ phone_mockup | image_url: width: 1200 }}" data-mockup-phone-width="{{ phone_mockup.width }}" data-mockup-phone-height="{{ phone_mockup.height }}"{% endif %} {% endif %} {{ block.shopify_attributes }}>
        <div class="bnon-portfolio-gallery__card-entrance">
          <div class="bnon-portfolio-gallery__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'bnon-portfolio-gallery__image', widths: '320, 480, 640, 900, 1200', sizes: '(min-width: 1024px) 25vw, 80vw', alt: block.settings.image.alt, loading: 'lazy' }}
          {%- else -%}
            <div class="bnon-portfolio-gallery__placeholder" aria-hidden="true"></div>
          {%- endif -%}
          </div>
          {%- if block.settings.project_name != blank -%}
            <bnon-portfolio-brand class="bnon-portfolio-gallery__brand"><span>{{ block.settings.project_name | escape }}</span></bnon-portfolio-brand>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
  </bnon-portfolio-mobile-slider>

  <div class="bnon-portfolio-gallery__next-boundary" aria-hidden="true"></div>
</section>
</bnon-portfolio-gallery-entrance>

{% render 'bnon-portfolio-mockup-modal', modal_id: 'bnon-portfolio-mockup-modal' %}

{% stylesheet %}
  .bnon-portfolio-gallery {
    --gallery-header-height: var(--bnon-header-height-reference, 120px);
    --gallery-intro-gap: clamp(20px, 2vw, 32px);
  }

  bnon-portfolio-gallery-entrance { display: block; }
  .bnon-portfolio-gallery__card-entrance { position: relative; width: 100%; height: 100%; border-radius: inherit; transform-origin: center bottom; }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__heading { font-size: 64px; }
  .bnon-portfolio-gallery .bnon-portfolio-gallery__description { font-size: 21.6px; }
  .bnon-portfolio-gallery .bnon-portfolio-gallery__eyebrow { font-size: 15.36px; }
  .bnon-portfolio-gallery__card { cursor: pointer; }

  /* Move the intro and gallery as one group. The scaled gallery silhouette
     starts 3.99vw into the stage and is 36.92vw tall: 15.07vw exposes its
     upper 30% at the fold, without changing the camera or any card plane.
     Natural content height takes precedence on short viewports. */
  .bnon-portfolio-gallery .bnon-portfolio-gallery__intro {
    box-sizing: border-box;
    min-height: calc(100svh - var(--gallery-header-height) - 15.07vw - var(--gallery-intro-gap) - 24px);
    padding-top: calc(clamp(96px, 12svh, 144px) - 24px);
    align-content: end;
  }

  /* Keep a compact group gap and an independent hook for future reveal. */
  .bnon-portfolio-gallery__reveal {
    position: relative;
    display: block;
    top: -120px;
    margin-top: var(--gallery-intro-gap);
    padding-bottom: 7vw;
  }

  @media screen and (max-width: 1023px) {
    .bnon-portfolio-gallery { --gallery-header-height: 88px; }
    .bnon-portfolio-gallery .bnon-portfolio-gallery__heading { font-size: 51.2px; }
    .bnon-portfolio-gallery .bnon-portfolio-gallery__description { font-size: 18.5px; }
  }

  @media screen and (max-width: 480px) {
    .bnon-portfolio-gallery { --gallery-header-height: 80px; }
    .bnon-portfolio-gallery .bnon-portfolio-gallery__heading { font-size: 38.4px; }
    .bnon-portfolio-gallery .bnon-portfolio-gallery__description { font-size: 15.36px; }
    .bnon-portfolio-gallery .bnon-portfolio-gallery__eyebrow { font-size: 11.52px; }
  }

  /* Reference 169:4623 is a flattened image. These planes reconstruct its
     seven complete cards from their projected left/right edges, excluding
     the partial cards beyond the reference viewport. At a 922px viewport,
     the central plane is 122px tall and the camera distance is 400px.
     Outer planes advance toward the camera; their outside edges are nearer.
     Widths and yaw are solved from those edge positions and heights, rather
     than enlarging rectangles into a U-shaped arrangement. */
  .bnon-portfolio-gallery .bnon-portfolio-gallery__stage {
    display: block;
    width: 100%;
    height: 39.0456vw;
    margin-top: 0;
    padding: 0;
    perspective: 43.3839vw;
    perspective-origin: 50% 50%;
    transform-style: preserve-3d;
    transform: scale(1.15);
    transform-origin: 50% 0;
  }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(n) {
    position: absolute;
    inset: 50% auto auto 50%;
    width: var(--gallery-width) !important;
    height: 13.2321vw !important;
    aspect-ratio: auto;
    margin: 0;
    overflow: visible;
    background: transparent;
    border-radius: 1.3015vw;
    transform-style: flat;
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    opacity: 1;
    transition: opacity 350ms ease, transform 350ms ease;
    transform: translate(-50%, -50%)
      translateX(var(--gallery-x)) translateZ(var(--gallery-z))
      rotateY(var(--gallery-yaw)) scale(var(--gallery-active-scale, 1));
  }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__card:focus-visible {
    opacity: 1;
    outline: 2px solid var(--bnon-color-mint);
    outline-offset: 4px;
  }

  .bnon-portfolio-gallery__stage:has(> .bnon-portfolio-gallery__card:focus-visible) > .bnon-portfolio-gallery__card:not(:focus-visible) {
    opacity: 0.5;
  }

  @media (hover: hover) and (pointer: fine) {
    .bnon-portfolio-gallery__stage:not(:has(> .bnon-portfolio-gallery__card:focus-visible)):has(> .bnon-portfolio-gallery__card:hover) > .bnon-portfolio-gallery__card:not(:hover) {
      opacity: 0.5;
    }
  }

  /* Keep the resting 3D geometry; scale in each card's own plane only.
     Touch/mobile devices retain focus feedback without enlargement. */
  @media screen and (min-width: 768px) and (hover: hover) and (pointer: fine) {
    .bnon-portfolio-gallery .bnon-portfolio-gallery__card:is(:hover, :focus-visible) {
      --gallery-active-scale: 1.025;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(n) {
      transition: none;
    }
  }

  .bnon-portfolio-gallery__media {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
    background: #0b0b0b;
  }

  /* Keep the image's original plane height/origin: the label extends below
     it, sharing the same projection without shifting any card geometry. */
  .bnon-portfolio-gallery__brand {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    margin: 0.9vw 0 0;
    color: #000;
    font-family: var(--bnon-font-latin);
    font-size: clamp(8px, 1.1vw, 18px);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bnon-portfolio-gallery__brand > span {
    display: inline-block;
  }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(1) {
    --gallery-x: -18.8836vw;
    --gallery-z: 20.8719vw;
    --gallery-width: 9.3296vw;
    --gallery-yaw: 83.078deg;
  }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(2) {
    --gallery-x: -16.1377vw;
    --gallery-z: 10.7500vw;
    --gallery-width: 9.3576vw;
    --gallery-yaw: 55.772deg;
  }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(3) {
    --gallery-x: -9.3955vw;
    --gallery-z: 2.6914vw;
    --gallery-width: 9.4823vw;
    --gallery-yaw: 29.556deg;
  }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(4) {
    --gallery-x: -0.1085vw;
    --gallery-z: 0vw;
    --gallery-width: 9.3275vw;
    --gallery-yaw: 0deg;
  }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(5) {
    --gallery-x: 9.3476vw;
    --gallery-z: 2.6914vw;
    --gallery-width: 9.3990vw;
    --gallery-yaw: -29.844deg;
  }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(6) {
    --gallery-x: 16.0349vw;
    --gallery-z: 10.6715vw;
    --gallery-width: 9.2149vw;
    --gallery-yaw: -55.341deg;
  }

  .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(7) {
    --gallery-x: 18.7791vw;
    --gallery-z: 20.7495vw;
    --gallery-width: 9.1131vw;
    --gallery-yaw: -81.656deg;
  }

  @media screen and (max-width: 480px) {
    .bnon-portfolio-gallery .bnon-portfolio-gallery__intro {
      min-height: 0;
      padding-top: 50px;
      align-content: start;
    }

    .bnon-portfolio-gallery__reveal {
      top: 0;
      margin-top: 32px;
    }

    .bnon-portfolio-gallery .bnon-portfolio-gallery__stage {
      height: 86vw;
      perspective: 238.6115vw;
      perspective-origin: 50% 50%;
      transform: none;
      touch-action: pan-y;
      user-select: none;
      cursor: grab;
    }

    .bnon-portfolio-gallery .bnon-portfolio-gallery__stage.is-dragging {
      cursor: grabbing;
    }

    .bnon-portfolio-gallery .bnon-portfolio-gallery__stage.is-initializing .bnon-portfolio-gallery__card {
      transition: none;
    }

    .bnon-portfolio-gallery .bnon-portfolio-gallery__stage.is-initializing {
      visibility: hidden;
    }

    .bnon-portfolio-gallery .bnon-portfolio-gallery__card.is-wrapping {
      transition: none;
    }

    .bnon-portfolio-gallery .bnon-portfolio-gallery__card:nth-child(n) {
      height: 72.7766vw !important;
      border-radius: 7.1583vw;
    }

    .bnon-portfolio-gallery__brand {
      margin-top: 4.95vw;
      font-size: clamp(9px, 3.04vw, 13px);
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('bnon-portfolio-gallery-entrance')) {
    customElements.define('bnon-portfolio-gallery-entrance', class extends HTMLElement {
      connectedCallback() {
        if (this.entranceObserver) return;
        this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.entranceObserver = new IntersectionObserver(entries => {
          if (this.entrancePlayed || !entries.some(entry => entry.isIntersecting)) return;
          this.entrancePlayed = true;
          this.entranceObserver.disconnect();
          if (this.reduced.matches) return;

          this.entranceAnimations = [];
          const animate = (element, frames, options) => {
            if (element?.animate) this.entranceAnimations.push(element.animate(frames, options));
          };
          animate(this.querySelector('.bnon-portfolio-gallery__heading'), [
            { opacity: 0, transform: 'translateY(25px)' }, { opacity: 1, transform: 'none' },
          ], { duration: 700, easing: 'cubic-bezier(.22, 1, .36, 1)', fill: 'backwards' });
          animate(this.querySelector('.bnon-portfolio-gallery__description'), [
            { opacity: 0, transform: 'translateY(15px)' }, { opacity: 1, transform: 'none' },
          ], { duration: 600, delay: 100, easing: 'cubic-bezier(.22, 1, .36, 1)', fill: 'backwards' });
          animate(this.querySelector('.bnon-portfolio-gallery__eyebrow'), [{ opacity: 0 }, { opacity: 1 }], {
            duration: 500, delay: 200, easing: 'ease-out', fill: 'backwards',
          });

          const mobile = window.matchMedia('(max-width: 767px)').matches;
          const mobileSlider = window.matchMedia('(max-width: 480px)').matches;
          const cardFrames = [
            { opacity: 0, transform: `translateY(${mobile ? 90 : 150}px) scale(${mobile ? .94 : .92})` },
            { opacity: 1, transform: 'none' },
          ];
          const wrappers = Array.from(this.querySelectorAll('.bnon-portfolio-gallery__card-entrance'));
          const center = Math.floor(wrappers.length / 2);
          const order = wrappers.map((wrapper, index) => ({ wrapper, distance: Math.abs(index - center), index }))
            .sort((a, b) => a.distance - b.distance || a.index - b.index);
          if (!mobileSlider) {
            order.forEach(({ wrapper }, index) => animate(wrapper, cardFrames, {
              duration: mobile ? 800 : 980,
              delay: 400 + index * (mobile ? 70 : 80),
              easing: 'cubic-bezier(.16, 1, .3, 1)',
              fill: 'backwards',
            }));
          }
        }, { threshold: .15, rootMargin: '0px 0px -20% 0px' });
        this.entranceObserver.observe(this.querySelector('.bnon-portfolio-gallery__stage') || this);
      }

      disconnectedCallback() {
        this.entranceObserver?.disconnect();
        this.entranceAnimations?.forEach(animation => animation.cancel());
      }
    });
  }

  if (!customElements.get('bnon-portfolio-brand')) {
    customElements.define('bnon-portfolio-brand', class extends HTMLElement {
      connectedCallback() {
        this.scheduleFit = () => {
          cancelAnimationFrame(this.fitFrame);
          this.fitFrame = requestAnimationFrame(() => this.fit());
        };
        this.sizeObserver = new ResizeObserver(this.scheduleFit);
        this.sizeObserver.observe(this.parentElement);
        this.textObserver = new MutationObserver(this.scheduleFit);
        this.textObserver.observe(this, { childList: true, characterData: true, subtree: true });
        document.fonts.addEventListener('loadingdone', this.scheduleFit);
        document.fonts.ready.then(() => {
          if (this.isConnected) this.scheduleFit();
        });
        this.scheduleFit();
      }

      fit() {
        const text = this.querySelector('span');
        if (!text) return;

        // Restore the responsive default before every measurement, so shorter
        // names and wider cards regain their original size. Layout widths are
        // measured before perspective, never from transformed bounding boxes.
        this.style.removeProperty('font-size');
        const style = getComputedStyle(this);
        const width = parseFloat(style.width);
        const defaultSize = parseFloat(style.fontSize);
        const textWidth = () => parseFloat(getComputedStyle(text).width);
        if (!width || textWidth() <= width) return;

        let low = 0;
        let high = defaultSize;
        for (let step = 0; step < 12; step += 1) {
          const size = (low + high) / 2;
          this.style.fontSize = `${size}px`;
          if (textWidth() <= width) low = size;
          else high = size;
        }
        this.style.fontSize = `${low}px`;
      }

      disconnectedCallback() {
        cancelAnimationFrame(this.fitFrame);
        this.sizeObserver.disconnect();
        this.textObserver.disconnect();
        document.fonts.removeEventListener('loadingdone', this.scheduleFit);
      }
    });
  }

  if (!customElements.get('bnon-portfolio-mobile-slider')) {
    customElements.define('bnon-portfolio-mobile-slider', class extends HTMLElement {
      connectedCallback() {
        if (this.controller) return;

        this.stage = this.querySelector('.bnon-portfolio-gallery__stage');
        this.cards = Array.from(this.querySelectorAll('[data-bnon-portfolio-card]'));
        if (!this.stage || this.cards.length < 2) return;

        this.slots = [
          { x: -103.8598, z: 114.7955, width: 51.3128, yaw: 83.078 },
          { x: -88.7574, z: 59.1250, width: 51.4668, yaw: 55.772 },
          { x: -51.6753, z: 14.8027, width: 52.1527, yaw: 29.556 },
          { x: -0.5968, z: 0, width: 51.3013, yaw: 0 },
          { x: 51.4118, z: 14.8027, width: 51.6945, yaw: -29.844 },
          { x: 88.1919, z: 58.6933, width: 50.6820, yaw: -55.341 },
          { x: 103.2851, z: 114.1223, width: 50.1221, yaw: -81.656 },
        ];
        this.mobile = window.matchMedia('(max-width: 480px)');
        this.activeIndex = 0;
        this.pointerId = null;
        this.startX = 0;
        this.startY = 0;
        this.dragged = false;
        this.suppressClickUntil = 0;
        this.controller = new AbortController();
        const options = { signal: this.controller.signal };

        this.mobile.addEventListener('change', () => this.syncMode(), options);
        this.stage.addEventListener('pointerdown', (event) => this.onPointerDown(event), options);
        this.stage.addEventListener('pointermove', (event) => this.onPointerMove(event), options);
        this.stage.addEventListener('pointerup', (event) => this.onPointerUp(event), options);
        this.stage.addEventListener('pointercancel', () => this.cancelDrag(), options);
        this.stage.addEventListener('click', (event) => {
          const suppressClick = this.dragged && performance.now() < this.suppressClickUntil;
          this.dragged = false;
          if (!suppressClick) return;
          event.preventDefault();
          event.stopImmediatePropagation();
        }, { capture: true, signal: this.controller.signal });
        this.stage.addEventListener('keydown', (event) => {
          if (!this.mobile.matches || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          this.move(event.key === 'ArrowRight' ? 1 : -1);
        }, options);

        this.syncMode();
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.controller = null;
      }

      syncMode() {
        if (this.mobile.matches) {
          this.setActive(this.activeIndex, false);
          return;
        }

        this.stage.classList.remove('is-dragging');
        this.cards.forEach((card) => {
          card.style.removeProperty('--gallery-x');
          card.style.removeProperty('--gallery-z');
          card.style.removeProperty('--gallery-width');
          card.style.removeProperty('--gallery-yaw');
          card.classList.remove('is-wrapping');
          delete card.dataset.mobileSlot;
          card.removeAttribute('aria-current');
        });
      }

      setActive(index, animate = true) {
        const count = this.cards.length;
        this.activeIndex = (index + count) % count;
        if (!animate) this.stage.classList.add('is-initializing');

        this.cards.forEach((card, cardIndex) => {
          let relative = cardIndex - this.activeIndex;
          if (relative > Math.floor(count / 2)) relative -= count;
          if (relative < -Math.floor(count / 2)) relative += count;
          const previousSlot = Number(card.dataset.mobileSlot);
          const wrapsAcrossGallery = animate
            && Number.isFinite(previousSlot)
            && Math.abs(relative - previousSlot) > 1;
          const slot = this.slots[Math.max(0, Math.min(6, relative + 3))];
          card.classList.toggle('is-wrapping', wrapsAcrossGallery);
          card.dataset.mobileSlot = String(relative);
          card.style.setProperty('--gallery-x', `${slot.x}vw`);
          card.style.setProperty('--gallery-z', `${slot.z}vw`);
          card.style.setProperty('--gallery-width', `${slot.width}vw`);
          card.style.setProperty('--gallery-yaw', `${slot.yaw}deg`);
          if (cardIndex === this.activeIndex) card.setAttribute('aria-current', 'true');
          else card.removeAttribute('aria-current');

          if (wrapsAcrossGallery) {
            requestAnimationFrame(() => requestAnimationFrame(() => card.classList.remove('is-wrapping')));
          }
        });

        if (!animate) requestAnimationFrame(() => this.stage.classList.remove('is-initializing'));
      }

      move(direction) {
        this.setActive(this.activeIndex + direction);
      }

      onPointerDown(event) {
        if (!this.mobile.matches || event.pointerType === 'mouse' && event.button !== 0) return;
        this.pointerId = event.pointerId;
        this.startX = event.clientX;
        this.startY = event.clientY;
        this.dragged = false;
        this.stage.setPointerCapture?.(event.pointerId);
      }

      onPointerMove(event) {
        if (event.pointerId !== this.pointerId) return;
        const deltaX = event.clientX - this.startX;
        const deltaY = event.clientY - this.startY;
        if (Math.abs(deltaX) > 8 && Math.abs(deltaX) > Math.abs(deltaY)) {
          this.dragged = true;
          this.stage.classList.add('is-dragging');
          event.preventDefault();
        }
      }

      onPointerUp(event) {
        if (event.pointerId !== this.pointerId) return;
        const deltaX = event.clientX - this.startX;
        const deltaY = event.clientY - this.startY;
        const wasSwipe = this.dragged || (Math.abs(deltaX) > 8 && Math.abs(deltaX) > Math.abs(deltaY));
        this.stage.releasePointerCapture?.(event.pointerId);
        this.pointerId = null;
        this.stage.classList.remove('is-dragging');
        if (wasSwipe) {
          this.dragged = true;
          this.suppressClickUntil = performance.now() + 600;
        }
        if (wasSwipe && Math.abs(deltaX) >= 36) this.move(deltaX < 0 ? 1 : -1);
      }

      cancelDrag() {
        if (this.dragged) this.suppressClickUntil = performance.now() + 600;
        this.pointerId = null;
        this.stage.classList.remove('is-dragging');
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "B&ON Portfolio Gallery",
  "tag": "div",
  "class": "bnon-portfolio-gallery-section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 7,
  "settings": [
    { "type": "text", "id": "heading", "label": "제목", "default": "PORTFOLIO" },
    { "type": "textarea", "id": "description", "label": "설명", "default": "다양한 브랜드와 함께 완성한\n글로벌 커머스 프로젝트를 만나보세요" },
    { "type": "text", "id": "eyebrow", "label": "보조 문구", "default": "Brands We’ve Built With." }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Portfolio 프로젝트",
      "settings": [
