{{ 'bnon-shopify-build.css' | asset_url | stylesheet_tag }}
{{ 'bnon-us-sections.css' | asset_url | stylesheet_tag }}

<section class="bnon-section bnon-shopify-build bnon-us-reasons"{% if section.settings.heading != blank %} aria-labelledby="UsReasonsHeading-{{ section.id }}"{% endif %} data-header-theme="light">
  <div class="bnon-shopify-build__inner">
    {%- if section.settings.label != blank -%}
      <div class="bnon-shopify-build__label-row"><p class="bnon-shopify-build__label">{{ section.settings.label | escape }}</p></div>
    {%- endif -%}
    <div class="bnon-shopify-build__intro">
      {%- if section.settings.heading != blank -%}
        <div class="bnon-shopify-build__title"><h2 class="bnon-shopify-build__heading" id="UsReasonsHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2></div>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="bnon-shopify-build__copy"><div class="bnon-shopify-build__paragraph">{{ section.settings.description }}</div></div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="bnon-shopify-build__pillars" role="list">
        {%- for block in section.blocks -%}
          <li class="bnon-shopify-build__pillar" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}<p class="bnon-shopify-build__number">{{ block.settings.number | escape }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h3 class="bnon-shopify-build__pillar-heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
            {%- if block.settings.description != blank -%}<p class="bnon-shopify-build__pillar-description">{{ block.settings.description | escape | newline_to_br }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "B&ON Why US Incorporation",
  "tag": "div",
  "class": "bnon-us-reasons-section",
  "limit": 1,
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "label", "label": "영문 섹션 라벨", "default": "WHY US INCORPORATION?" },
    { "type": "textarea", "id": "heading", "label": "메인 제목", "default": "왜 미국 법인을 설립해야 할까요?" },
    { "type": "richtext", "id": "description", "label": "소개 문구 및 강조", "default": "<p>미국 법인 설립은 <strong>글로벌 시장 진출을 위한 비즈니스 기반을 마련</strong>하는 과정입니다.</p>" }
  ],
  "max_blocks": 3,
  "blocks": [{ "type": "reason", "name": "법인 설립 장점", "settings": [
    { "type": "text", "id": "number", "label": "표시 번호" },
    { "type": "text", "id": "heading", "label": "항목 제목" },
    { "type": "textarea", "id": "description", "label": "항목 설명" }
  ] }],
  "presets": [{ "name": "B&ON Why US Incorporation", "blocks": [
    { "type": "reason", "settings": { "number": "01", "heading": "글로벌 비즈니스 신뢰도", "description": "미국 현지 법인을 기반으로 해외 고객 및 파트너와의 거래 신뢰도를 높입니다" } },
    { "type": "reason", "settings": { "number": "02", "heading": "글로벌 브랜드 성장", "description": "미국 시장을 기반으로 글로벌 판매와\n비즈니스 확장을 위한 환경을 마련합니다." } },
    { "type": "reason", "settings": { "number": "03", "heading": "효율적인 법인 운영", "description": "사업에 적합한 법인 구조를 검토하고\n효율적인 운영 기반을 구축합니다." } }
  ] }]
}
{% endschema %}
