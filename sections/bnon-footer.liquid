{%- liquid
  assign footer_contact_link = section.settings.contact_link | default: '/pages/contact'
  assign footer_project_link = section.settings.project_link | default: '/pages/portfolio'
-%}

<section class="bnon-section bnon-footer-v2" aria-label="{{ shop.name | escape }} footer">
  <div class="bnon-footer-v2__container">

    <div class="bnon-footer-v2__top">
      <div class="bnon-footer-v2__identity">

        {%- if section.settings.logo_image != blank -%}
          {{
            section.settings.logo_image
            | image_url: width: 394
            | image_tag:
              class: 'bnon-footer-v2__logo-image',
              widths: '197, 394',
              alt: section.settings.logo_image.alt
          }}
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="bnon-footer-v2__tagline">
            {{ section.settings.tagline | escape }}
          </p>
        {%- endif -%}

      </div>

      <nav class="bnon-footer-v2__info-grid" aria-label="Footer navigation">

        <a href="{{ footer_contact_link }}">
          프로젝트 문의
        </a>

        <a href="{{ footer_project_link }}">
          포트폴리오
        </a>

        {%- if section.settings.shopify_link != blank -%}
          <a href="{{ section.settings.shopify_link }}">
            SHOPIFY
          </a>
        {%- else -%}
          <span>SHOPIFY</span>
        {%- endif -%}

        <a href="#" download aria-label="회사소개서 다운로드">
          회사소개서 <span aria-hidden="true">↓</span>
        </a>

      </nav>
    </div>

    <div class="bnon-footer-v2__bottom">

      {%- if shop.policies.size > 0 -%}
        <nav aria-label="Policy navigation">
          <ul class="bnon-footer-v2__policies" role="list">

            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <a href="{{ policy.url }}">
                    {{ policy.title | escape }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}

          </ul>
        </nav>
      {%- endif -%}

      <p class="bnon-footer-v2__copyright">
        {{ section.settings.copyright | escape }}
      </p>

    </div>

  </div>


  {%- if section.settings.giant_logo_image != blank -%}

    <p class="bnon-footer-v2__giant bnon-footer-v2__giant--image" aria-hidden="true">
      {{
        section.settings.giant_logo_image
        | image_url: width: 3200
        | image_tag:
          class: 'bnon-footer-v2__giant-image',
          widths: '750, 1000, 1500, 2000, 2400, 3200',
          loading: 'lazy'
      }}
    </p>

  {%- endif -%}

</section>


<style>
  /* 기존 giant 텍스트의 위치/레이아웃은 그대로 사용 */
  .bnon-footer-v2__giant--image {
    line-height: 0;
  }

  .bnon-footer-v2__giant-image {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    object-fit: contain;
  }
</style>


{% schema %}
{
  "name": "B&ON Footer",
  "tag": "div",
  "class": "bnon-footer-v2-section",

  "enabled_on": {
    "groups": ["footer"]
  },

  "settings": [

    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "상단 로고 이미지"
    },

    {
      "type": "text",
      "id": "tagline",
      "label": "태그라인",
      "default": "Building global commerce with Shopify."
    },

    {
      "type": "text",
      "id": "contact_label",
      "label": "CONTACT 문구"
    },

    {
      "type": "url",
      "id": "contact_link",
      "label": "CONTACT 링크"
    },

    {
      "type": "text",
      "id": "project_label",
      "label": "PROJECT 문구"
    },

    {
      "type": "url",
      "id": "project_link",
      "label": "PROJECT 링크"
    },

    {
      "type": "text",
      "id": "shopify_label",
      "label": "SHOPIFY 문구"
    },

    {
      "type": "url",
      "id": "shopify_link",
      "label": "SHOPIFY 링크"
    },

    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "© 2026 B&ON UNIVERSE. All Rights Reserved."
    },

    {
      "type": "header",
      "content": "하단 대형 로고"
    },

    {
      "type": "image_picker",
      "id": "giant_logo_image",
      "label": "하단 대형 로고 이미지"
    }

  ],

  "presets": [
    {
      "name": "B&ON Footer"
    }
  ]
}
{% endschema %}