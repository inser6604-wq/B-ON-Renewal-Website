<script src="{{ 'bnon-interactions.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.settings.published
      assign visible_count = visible_count | plus: 1
    endif
  endfor
  assign view_all_link = section.settings.view_all_link | default: '/pages/portfolio'
-%}

{%- if visible_count > 0 -%}
  <bnon-main-portfolio
    data-bnon-main-portfolio
    data-enable-next-hint="{{ section.settings.enable_next_hint }}"
  >
    <section class="bnon-section bnon-main-portfolio" aria-labelledby="bnon-main-portfolio-heading-{{ section.id }}">
      <div class="bnon-main-portfolio__stage">
        <div class="bnon-container bnon-main-portfolio__container">
        <div class="bnon-main-portfolio__masthead">
          <h2 class="bnon-main-portfolio__heading" id="bnon-main-portfolio-heading-{{ section.id }}">
            {{ section.settings.heading | escape }}
          </h2>

          <div class="bnon-main-portfolio__tabs-wrap">
            <div class="bnon-main-portfolio__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }} 프로젝트">
              {%- assign visible_index = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.published -%}
                {%- liquid
                  assign visible_index = visible_index | plus: 1
                  assign tab_id = 'bnon-main-portfolio-tab-' | append: section.id | append: '-' | append: block.id
                  assign panel_id = 'bnon-main-portfolio-panel-' | append: section.id | append: '-' | append: block.id
                -%}
                <button
                  class="bnon-main-portfolio__tab"
                  type="button"
                  role="tab"
                  id="{{ tab_id }}"
                  aria-controls="{{ panel_id }}"
                  aria-selected="{% if visible_index == 1 %}true{% else %}false{% endif %}"
                  tabindex="{% if visible_index == 1 %}0{% else %}-1{% endif %}"
                  data-bnon-project-tab
                  data-bnon-project-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <span>{{ block.settings.project_name | escape }}</span>
                </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <p class="bnon-main-portfolio__count" aria-live="polite">
            <span data-bnon-project-current>01</span><span aria-hidden="true"> / </span><span data-bnon-project-total>{{ visible_count | prepend: '0' }}</span>
          </p>
        </div>
        </div>

        <div class="bnon-main-portfolio__panels">
          {%- assign visible_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.published -%}
            {%- liquid
              assign visible_index = visible_index | plus: 1
              assign tab_id = 'bnon-main-portfolio-tab-' | append: section.id | append: '-' | append: block.id
              assign panel_id = 'bnon-main-portfolio-panel-' | append: section.id | append: '-' | append: block.id
            -%}
            <article
              class="bnon-main-portfolio__panel{% if visible_index == 1 %} is-active{% endif %}"
              id="{{ panel_id }}"
              role="tabpanel"
              tabindex="0"
              aria-labelledby="{{ tab_id }}"
              data-bnon-project-panel
              data-bnon-project-id="{{ block.id }}"
              {% unless visible_index == 1 %}hidden{% endunless %}
            >
              <div class="bnon-main-portfolio__background" aria-hidden="true">
                {%- if block.settings.background_image != blank -%}
                  {{ block.settings.background_image | image_url: width: 2880 | image_tag: class: 'bnon-main-portfolio__background-image', widths: '750, 1024, 1440, 1920, 2880', sizes: '100vw', alt: '', loading: 'lazy' }}
                {%- endif -%}
              </div>

              <div class="bnon-main-portfolio__project-content">
                <div class="bnon-main-portfolio__project-copy">
                  <h3 class="bnon-main-portfolio__project-name">{{ block.settings.project_name | escape }}</h3>
                  {%- if block.settings.category != blank -%}
                    <p class="bnon-main-portfolio__category">{{ block.settings.category | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.scope_1 != blank or block.settings.scope_2 != blank or block.settings.scope_3 != blank -%}
                    <ul class="bnon-main-portfolio__scopes" role="list">
                      {%- if block.settings.scope_1 != blank -%}<li>{{ block.settings.scope_1 | escape }}</li>{%- endif -%}
                      {%- if block.settings.scope_2 != blank -%}<li>{{ block.settings.scope_2 | escape }}</li>{%- endif -%}
                      {%- if block.settings.scope_3 != blank -%}<li>{{ block.settings.scope_3 | escape }}</li>{%- endif -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="bnon-main-portfolio__links">
                  {%- if block.settings.project_link != blank -%}
                    <a class="bnon-main-portfolio__link bnon-main-portfolio__project-link" href="{{ block.settings.project_link | escape }}" data-bnon-project-link data-bnon-project-id="{{ block.id }}">
                      <span>{{ block.settings.view_project_label | escape }}</span><span aria-hidden="true">→</span>
                    </a>
                  {%- else -%}
                    <span class="bnon-main-portfolio__link bnon-main-portfolio__project-link is-disabled" data-bnon-project-link data-bnon-project-id="{{ block.id }}">
                      <span>{{ block.settings.view_project_label | escape }}</span><span aria-hidden="true">→</span>
                    </span>
                  {%- endif -%}
                  <a class="bnon-main-portfolio__link bnon-main-portfolio__all-link" href="{{ view_all_link | escape }}">
                    <span>{{ section.settings.view_all_label | escape }}</span><span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>

              <div class="bnon-main-portfolio__mockup" aria-hidden="true">
                {%- if block.settings.mockup_image != blank -%}
                  {{ block.settings.mockup_image | image_url: width: 900 | image_tag: class: 'bnon-main-portfolio__mockup-image', widths: '300, 450, 600, 900', sizes: '(min-width: 1024px) 306px, 35vw', alt: '', loading: 'lazy' }}
                {%- endif -%}
              </div>
            </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  </bnon-main-portfolio>
{%- endif -%}

{% schema %}
{
  "name": "B&ON Main Portfolio",
  "tag": "div",
  "class": "bnon-main-portfolio-section",
  "limit": 1,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "섹션 제목", "default": "Portfolio" },
    { "type": "text", "id": "view_all_label", "label": "전체 프로젝트 링크 문구", "default": "VIEW ALL PROJECT" },
    { "type": "url", "id": "view_all_link", "label": "전체 프로젝트 링크" },
    { "type": "checkbox", "id": "enable_next_hint", "label": "다음 탭 민트 힌트 표시", "default": true }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "프로젝트",
      "limit": 6,
      "settings": [
        { "type": "checkbox", "id": "published", "label": "공개", "default": true },
        { "type": "text", "id": "project_name", "label": "프로젝트명", "default": "PROJECT NAME" },
        { "type": "text", "id": "category", "label": "카테고리" },
        { "type": "text", "id": "scope_1", "label": "범위 1" },
        { "type": "text", "id": "scope_2", "label": "범위 2" },
        { "type": "text", "id": "scope_3", "label": "범위 3" },
        { "type": "image_picker", "id": "background_image", "label": "배경 이미지" },
        { "type": "image_picker", "id": "mockup_image", "label": "목업 이미지" },
        { "type": "text", "id": "view_project_label", "label": "프로젝트 링크 문구", "default": "VIEW PROJECT" },
        { "type": "url", "id": "project_link", "label": "프로젝트 링크" }
      ]
    }
  ],
  "presets": [
    {
      "name": "B&ON Main Portfolio",
      "blocks": [
        { "type": "project", "settings": { "project_name": "MONCLOS", "category": "BEAUTY · SKINCARE", "scope_1": "BRAND STRATEGY", "scope_2": "UX/UI DESIGN", "scope_3": "SHOPIFY DEVELOPMENT" } },
        { "type": "project", "settings": { "project_name": "ENTALPY" } },
        { "type": "project", "settings": { "project_name": "OLLOCDAM" } },
        { "type": "project", "settings": { "project_name": "CCLIME" } },
        { "type": "project", "settings": { "project_name": "HOZI" } },
        { "type": "project", "settings": { "project_name": "INMI SEOUL" } }
      ]
    }
  ]
}
{% endschema %}
