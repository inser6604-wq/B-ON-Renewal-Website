{{ 'bnon-shopify-build.css' | asset_url | stylesheet_tag }}
{{ 'bnon-us-payments.css' | asset_url | stylesheet_tag }}

<section class="bnon-section bnon-shopify-build bnon-us-comparison"{% if section.settings.heading != blank %} aria-labelledby="UsComparisonHeading-{{ section.id }}"{% endif %} data-header-theme="light">
  <div class="bnon-shopify-build__inner">
    {%- if section.settings.label != blank -%}<div class="bnon-shopify-build__label-row"><p class="bnon-shopify-build__label">{{ section.settings.label | escape }}</p></div>{%- endif -%}
    <div class="bnon-us-comparison__intro">
      {%- if section.settings.heading != blank -%}<div class="bnon-shopify-build__title"><h2 class="bnon-shopify-build__heading" id="UsComparisonHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}<span class="bnon-shopify-build__accent">{{ section.settings.heading_accent | escape }}</span></h2></div>{%- endif -%}
      {%- if section.settings.description != blank -%}<div class="bnon-shopify-build__copy"><p class="bnon-shopify-build__paragraph">{{ section.settings.description | escape | newline_to_br }}</p></div>{%- endif -%}
    </div>
    <div class="bnon-us-comparison__grid">
      <div class="bnon-shopify-benefits__card bnon-us-comparison__featured">
        {%- if section.settings.featured_label != blank -%}<p class="bnon-us-comparison__featured-label">{{ section.settings.featured_label | escape }}</p>{%- endif -%}
        {%- if section.settings.featured_heading != blank -%}<h3 class="bnon-us-comparison__featured-heading">{{ section.settings.featured_heading | escape | newline_to_br }}</h3>{%- endif -%}
        {%- assign metrics = section.blocks | where: 'type', 'metric' -%}
        {%- if metrics.size > 0 -%}
          <dl class="bnon-us-comparison__metrics">
            {%- for block in metrics -%}
              <div class="bnon-us-comparison__metric" {{ block.shopify_attributes }}>
                <dt>{{ block.settings.label | escape }}</dt>
                <dd>{{ block.settings.value | escape | newline_to_br }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        {%- endif -%}
      </div>
      {%- assign providers = section.blocks | where: 'type', 'provider' -%}
      {%- if providers.size > 0 -%}
        <ol class="bnon-us-comparison__providers" role="list">
          {%- for block in providers -%}
            <li class="bnon-shopify-benefits__card bnon-us-comparison__provider" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
              {%- if block.settings.fees != blank -%}<p>{{ block.settings.fees | escape }}</p>{%- endif -%}
              {%- if block.settings.approval != blank -%}<p>{{ block.settings.approval | escape }}</p>{%- endif -%}
              {%- if block.settings.settlement != blank -%}<p>{{ block.settings.settlement | escape }}</p>{%- endif -%}
              {%- if block.settings.currency != blank -%}<p>{{ block.settings.currency | escape }}</p>{%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "B&ON Payment Comparison",
  "tag": "div", "class": "bnon-us-comparison-section", "limit": 1,
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "label", "label": "영문 섹션 라벨", "default": "PAYMENT COMPARISON" },
    { "type": "textarea", "id": "heading", "label": "메인 제목", "default": "결제 시스템의 차이\n한눈에 비교하다" },
    { "type": "text", "id": "heading_accent", "label": "제목 끝 민트색 문자", "default": "." },
    { "type": "textarea", "id": "description", "label": "소개 문구", "default": "주요 결제 서비스의 수수료와 운영 조건을 비교합니다." },
    { "type": "text", "id": "featured_label", "label": "추천 결제 카드 영문 라벨", "default": "FEATURED PAYMENT SOLUTION" },
    { "type": "textarea", "id": "featured_heading", "label": "추천 결제 서비스명", "default": "Shopify\nPayments." }
  ],
  "max_blocks": 6,
  "blocks": [
    { "type": "metric", "name": "Shopify Payments 비교 항목", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "항목명" },
      { "type": "textarea", "id": "value", "label": "항목 값 및 설명" }
    ] },
    { "type": "provider", "name": "다른 결제 서비스", "limit": 2, "settings": [
      { "type": "text", "id": "heading", "label": "결제 서비스명" },
      { "type": "textarea", "id": "fees", "label": "추가 거래 수수료 문구" },
      { "type": "textarea", "id": "approval", "label": "결제 승인율 문구" },
      { "type": "textarea", "id": "settlement", "label": "정산 속도 문구" },
      { "type": "textarea", "id": "currency", "label": "다국가 통화 문구" }
    ] }
  ],
  "presets": [{ "name": "B&ON Payment Comparison", "blocks": [
    { "type": "metric", "settings": { "label": "외부 PG 추가 수수료", "value": "면제" } },
    { "type": "metric", "settings": { "label": "결제 승인율", "value": "글로벌 카드 네트워크 기반 결제 지원" } },
    { "type": "metric", "settings": { "label": "정산 속도", "value": "미국 기준 통상 영업일 3~5일 내 입금" } },
    { "type": "metric", "settings": { "label": "다국가 통화", "value": "지원 조건별 제공" } },
    { "type": "provider", "settings": { "heading": "PayPal", "fees": "추가 거래 수수료: 조건별 상이", "approval": "결제 승인율 : 결제 수단 및 거래 조건에 따라 상이", "settlement": "정산 속도:  출금 방식 및 계정 조건에 따라 상이", "currency": "다국가 통화: 지원 조건별" } },
    { "type": "provider", "settings": { "heading": "외부 PG", "fees": "추가 거래 수수료: 요금제별 상이", "approval": "결제 승인율 : PG사 및 카드사별 승인 조건 상이", "settlement": "정산 속도 : PG사별 정산 주기 상이", "currency": "다국가 통화 : PG사별 상이" } }
  ] }]
}
{% endschema %}
