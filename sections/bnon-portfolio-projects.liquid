<section class="bnon-section bnon-portfolio-projects" aria-labelledby="portfolio-projects-heading-{{ section.id }}">
  <div class="bnon-portfolio-projects__intro">
    <h2 id="portfolio-projects-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.description != blank -%}
      <p>{{ section.settings.description | escape | newline_to_br }}</p>
    {%- endif -%}
  </div>
  <div class="bnon-portfolio-projects__gallery">
    {%- assign row_remaining = 0 -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign card_size = block.settings.card_size | default: 'medium'
        if row_remaining == 0
          assign row_count = 1
          assign row_kind = card_size
          assign next_index = forloop.index0 | plus: 1
          assign next_block = section.blocks[next_index]
          assign next_size = next_block.settings.card_size
          if card_size == 'large' and next_size == 'medium'
            assign row_count = 2
            assign row_kind = 'pair'
          elsif card_size == 'medium' and next_size == 'large'
            assign row_count = 2
            assign row_kind = 'pair'
          elsif card_size == 'small' and next_size == 'small'
            assign row_count = 2
            assign third_index = next_index | plus: 1
            assign third_block = section.blocks[third_index]
            if third_block.settings.card_size == 'small'
              assign row_count = 3
            endif
          endif
          assign row_remaining = row_count
        endif
        assign project_title = block.settings.project_title | default: 'PROJECT'
        assign image_alt = block.settings.project_image.alt | default: project_title
        assign desktop_mockup = block.settings.mockup_desktop_image
        assign phone_mockup = block.settings.mockup_phone_image
        assign has_mockup = false
        if desktop_mockup != blank or phone_mockup != blank
          assign has_mockup = true
        endif
      -%}
      {%- if row_remaining == row_count -%}
        <div class="bnon-portfolio-projects__row bnon-portfolio-projects__row--{{ row_kind }}">
      {%- endif -%}
      <article class="bnon-portfolio-projects__card bnon-portfolio-projects__card--{{ card_size }}" aria-label="{{ project_title | escape }}" {{ block.shopify_attributes }}>
        {%- if block.settings.project_link != blank -%}
          <a class="bnon-portfolio-projects__surface" href="{{ block.settings.project_link | escape }}" aria-label="{{ project_title | escape }}"{% if has_mockup %} role="button" aria-haspopup="dialog" aria-controls="bnon-portfolio-mockup-modal" data-mockup-trigger data-mockup-title="{{ project_title | escape }}" data-live-site-url="{{ block.settings.live_site_url | escape }}"{% if desktop_mockup != blank %} data-mockup-desktop-src="{{ desktop_mockup | image_url: width: 2400 }}" data-mockup-desktop-width="{{ desktop_mockup.width }}" data-mockup-desktop-height="{{ desktop_mockup.height }}"{% endif %}{% if phone_mockup != blank %} data-mockup-phone-src="{{ phone_mockup | image_url: width: 1200 }}" data-mockup-phone-width="{{ phone_mockup.width }}" data-mockup-phone-height="{{ phone_mockup.height }}"{% endif %}{% endif %}>
        {%- else -%}
          <div class="bnon-portfolio-projects__surface"{% if has_mockup %} tabindex="0" role="button" aria-haspopup="dialog" aria-controls="bnon-portfolio-mockup-modal" aria-label="{{ project_title | escape }}" data-mockup-trigger data-mockup-title="{{ project_title | escape }}" data-live-site-url="{{ block.settings.live_site_url | escape }}"{% if desktop_mockup != blank %} data-mockup-desktop-src="{{ desktop_mockup | image_url: width: 2400 }}" data-mockup-desktop-width="{{ desktop_mockup.width }}" data-mockup-desktop-height="{{ desktop_mockup.height }}"{% endif %}{% if phone_mockup != blank %} data-mockup-phone-src="{{ phone_mockup | image_url: width: 1200 }}" data-mockup-phone-width="{{ phone_mockup.width }}" data-mockup-phone-height="{{ phone_mockup.height }}"{% endif %}{% endif %}>
        {%- endif -%}
          {%- if block.settings.project_image != blank -%}
            {{ block.settings.project_image | image_url: width: 2600 | image_tag: class: 'bnon-portfolio-projects__image', widths: '410, 520, 736, 1040, 1472, 1920, 2600', sizes: '(max-width: 767px) 100vw, (max-width: 1440px) 90vw, 1286px', alt: image_alt, loading: 'lazy' }}
          {%- elsif request.design_mode -%}
            <span class="bnon-portfolio-projects__empty">{{ project_title | escape }}</span>
          {%- endif -%}
          {%- if block.settings.project_logo != blank -%}
            <div class="bnon-portfolio-projects__logo" style="--project-logo-scale: {{ block.settings.logo_scale | default: 100 | divided_by: 100.0 }};">
              {{ block.settings.project_logo | image_url: width: 800 | image_tag: widths: '200, 400, 600, 800', sizes: '(max-width: 767px) 45vw, 350px', alt: '', loading: 'lazy' }}
            </div>
          {%- endif -%}
        {%- if block.settings.project_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      </article>
      {%- assign row_remaining = row_remaining | minus: 1 -%}
      {%- if row_remaining == 0 -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .bnon-portfolio-projects { padding: 100px 24px 120px; background: var(--bnon-color-white); }
  .bnon-portfolio-projects__intro { display: grid; gap: 20px; margin: 0 auto 100px; text-align: center; }
  .bnon-portfolio-projects__intro h2 { margin: 0; color: var(--bnon-color-black); font-family: var(--bnon-font-latin); font-size: 80px; font-weight: 800; line-height: 1.4; letter-spacing: -.04em; }
  .bnon-portfolio-projects__intro p { margin: 0; font-family: var(--bnon-font-korean); font-size: 24px; font-weight: 400; line-height: 1.4; letter-spacing: -.04em; }
  .bnon-portfolio-projects__gallery { display: grid; gap: 60px; max-width: 1286px; margin-inline: auto; }
  .bnon-portfolio-projects__row { display: flex; align-items: flex-end; gap: 25px; }
  .bnon-portfolio-projects__card { position: relative; flex: none; min-width: 0; overflow: hidden; border-radius: 20px; background: var(--bnon-color-gray); }
  .bnon-portfolio-projects__card--large { width: 100%; aspect-ratio: 1286 / 620; }
  .bnon-portfolio-projects__card--medium { width: calc((100% - 25px) * .414013); aspect-ratio: 520 / 400; }
  .bnon-portfolio-projects__row--pair .bnon-portfolio-projects__card--large { width: calc((100% - 25px) * .585987); aspect-ratio: 736 / 520; }
  .bnon-portfolio-projects__row--small { gap: 28px; }
  .bnon-portfolio-projects__card--small { width: calc((100% - 56px) / 3); aspect-ratio: 410 / 360; }
  .bnon-portfolio-projects__surface { display: block; position: absolute; inset: 0; color: inherit; text-decoration: none; }
  .bnon-portfolio-projects__surface:focus-visible { outline: 3px solid var(--bnon-color-mint); outline-offset: -6px; border-radius: inherit; }
  .bnon-portfolio-projects__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .bnon-portfolio-projects__logo { position: absolute; bottom: 7%; left: 50%; width: 36%; height: 16%; transform: translateX(-50%) scale(var(--project-logo-scale, 1)); transform-origin: center bottom; pointer-events: none; }
  .bnon-portfolio-projects__card--medium .bnon-portfolio-projects__logo { width: 42%; height: 15%; }
  .bnon-portfolio-projects__card--small .bnon-portfolio-projects__logo { width: 44%; height: 14%; bottom: 5%; }
  .bnon-portfolio-projects__logo img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  .bnon-portfolio-projects__empty { display: grid; height: 100%; place-items: center; padding: 16px; box-sizing: border-box; text-align: center; }
  @media screen and (max-width: 1023px) {
    .bnon-portfolio-projects { padding-block: 72px 88px; }
    .bnon-portfolio-projects__intro { margin-bottom: 64px; }
    .bnon-portfolio-projects__intro h2 { font-size: 64px; }
    .bnon-portfolio-projects__intro p { font-size: 20px; }
    .bnon-portfolio-projects__gallery { gap: 40px; }
  }
  @media screen and (max-width: 767px) {
    .bnon-portfolio-projects { padding: 56px 20px 64px; }
    .bnon-portfolio-projects__intro { gap: 16px; margin-bottom: 40px; }
    .bnon-portfolio-projects__intro h2 { font-size: clamp(32px, 8vw, 48px); }
    .bnon-portfolio-projects__intro p { font-size: 16px; }
    .bnon-portfolio-projects__gallery { gap: 24px; }
    .bnon-portfolio-projects__row { gap: 12px; }
    .bnon-portfolio-projects__card { border-radius: 12px; }
    .bnon-portfolio-projects__row--pair .bnon-portfolio-projects__card--large { width: calc((100% - 12px) * .585987); }
    .bnon-portfolio-projects__card--medium { width: calc((100% - 12px) * .414013); }
    .bnon-portfolio-projects__card--small { width: calc((100% - 24px) / 3); }
  }
{% endstylesheet %}

